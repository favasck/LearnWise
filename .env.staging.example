# Copy to .env.staging.local only for an approved NONPRODUCTION project.
# Never commit populated configuration or use a production user session.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
LEARNWISE_STAGING_APPROVED=false
# An authenticated disposable staging user's current access token, not a service key.
# Used only by the local read-only checker; never exposed through VITE variables.
LEARNWISE_STAGING_ACCESS_TOKEN=
